{
  "installCommand": "npm install",
  "buildCommand": "node artifacts/api-server/build.mjs && vite build --config artifacts/steamshare/vite.config.ts",
  "outputDirectory": "artifacts/steamshare/dist/public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
